<application>
<name>DemoLLM_FC</name>
    <authors>
        <author email="carmela.calabrese@iit.it">Carmela Calabrese</author>
    </authors>

  <!-- yarprobotinterface -->
  <!-- yarpmotorgui -->
  <!-- realsense -->
  <!-- emotions -->

  <module>
		<name>yarplogger</name>
		<parameters>--start</parameters>
    <node>r1-base</node>
  </module>

  <module>
		<name>yarprobotinterface</name>
    <node>r1-base</node>
  </module>

  <module>
		<name>yarprobotinterface</name>
		<parameters>--context navigation2 --from realsense2_remote.ini</parameters>
    <node>r1-torso</node>
  </module>

  <module>
		<name>yarprobotinterface</name>
		<parameters>--context headSynchronizer --from faceDisplay.ini</parameters>
    <node>r1-face</node>
  </module>

  <module>
		<name>faceExpressionImage5GTour</name>
		<node>console-llm</node>
  </module>

  <module>
		<name>/usr/local/src/robot/hsp/ergocub-bimanual/build/command_prompt</name>
		<parameters>/Components/Manipulation /usr/local/src/robot/hsp/ergocub-bimanual/config/ergocub_real.ini</parameters>
    <node>ergocub-torso</node>
  </module>

  <module>
		<name>/usr/local/src/robot/hsp/ergocub-bimanual/build/command_server</name>
		<parameters>/Components/Manipulation /ergocub /usr/local/src/robot/robotology-superbuild/src/ergocub-software/urdf/ergoCub/robots/ergoCubSN001/model.urdf /usr/local/src/robot/hsp/ergocub-bimanual/config/ergocub_real_wristless.ini</parameters>
    <node>ergocub-torso</node>
  </module>

  <module>
		<name>yarpview</name>
		<parameters>--name /viewer</parameters>
    <node>console</node>
	</module>

  <module>
		<name>yarpview</name>
		<parameters>--name /viewer_yoloDet</parameters>
    <node>console</node>
	</module>

  <module>
		<name>python</name>
		<parameters>/app/yarp_yolo_world.py</parameters>
    <node>yolo_node</node>
	</module>

  <module>
		<name>python</name>
		<parameters>/app/LLM4chatting/code/chatGUI.py</parameters>
    <node>planner_node</node>
	</module>

  <module>
		<name>python</name>
		<parameters>/app/LLM4chatting/code/FakeRobotNWS.py</parameters>
    <node>planner_node</node>
	</module>
  
  <module>
		<name>python</name>
		<parameters>/app/LLM4chatting/code/planner_GUI.py --config /app/LLM4chatting/code/configs/gpt_config_fc.json</parameters>
    <node>planner_node</node>
  </module>

  <module>
		<name>python</name>
		<parameters>/app/LLM4chatting/code/observer.py --config /app/LLM4chatting/code/configs/gpt_config_obs.json</parameters>
    <node>planner_node</node>
	</module>

  <module>
		<name>python</name>
		<parameters>/app/LLM4chatting/code/internal_robot_state.py --config /app/LLM4chatting/code/configs/gpt_config_intState.json</parameters>
    <node>planner_node</node>
	</module>

  <module>
    <name>yarprobotinterface</name>
    <parameters>--context speechPipeline --from micAudio.ini --mic_sound_on_stop 0 --mic_start 1 --mic_min_samples 4000 --mic_max_samples 4000</parameters>
    <node>r1-torso</node>
  </module>

  <module>
    <name>python3</name>
    <parameters>/usr/local/src/robot/tour-guide-robot/aux_modules/speechProcessing/openWakeWord/oww.py --models hey_erra_uno.onnx</parameters>
    <node>console-llm</node>
  </module>  

  <module>
    <name>python3</name>
    <parameters>/usr/local/src/robot/tour-guide-robot/aux_modules/speechProcessing/wakeWordDetection/play_notification.py</parameters>
    <node>r1-face</node>
  </module>  

  <module>
    <name>sileroVAD</name>
    <node>console-llm</node>
  </module>
    
  <module>
    <name>yarprobotinterface</name>
    <parameters>--context vadModule --from audioPlayer.ini</parameters>
    <node>speech_docker</node>
  </module>
    
  
  <!-- speech synthesizer -->
  <module>
    <name>yarprobotinterface</name>
    <parameters>--context google --from googleSynthesizer.ini --synthesis_lang it-IT --synthesis_voice it-IT-Neural2-A</parameters>
    <node>console-llm</node>
  </module>
    
  <!-- speech transcriber -->
  <module>
    <name>yarprobotinterface</name>
    <parameters>---context google --from googleTranscription.ini --transcription_lang it-IT</parameters>
    <node>console-llm</node>
  </module>

