<application>
<name>DemoLLM_FC</name>
    <authors>
        <author email="carmela.calabrese@iit.it">Carmela Calabrese</author>
    </authors>

  <!-- yarprobotinterface -->
  <!-- yarpmotorgui -->
  <!-- realsense -->
  <!-- emotions -->

  <module>
		<name>yarplogger</name>
		<parameters>--start</parameters>
    <node>r1-base</node>
  </module>

  <module>
		<name>yarprobotinterface</name>
    <node>r1-base</node>
    <workdir>/usr/local/src/robot/robots-configuration/R1SN003/</workdir>
  </module>

  <module>
		<name>./set_navigation_position.sh</name>
    <node>console</node>
    <workdir>/usr/local/src/robot/tour-guide-robot/app/navigation2/scripts/</workdir>
  </module>
    

  <module>
		<name>yarprobotinterface</name>
		<parameters>--context navigation2 --from realsense2_remote.ini</parameters>
    <node>r1-torso</node>
  </module>


  <module>
		<name>yarpview</name>
		<parameters>--name /viewer</parameters>
    <node>console</node>
	</module>

  <module>
		<name>yarpview</name>
		<parameters>--name /viewer_yoloDet</parameters>
    <node>console</node>
	</module>

  <module>
		<name>python</name>
		<parameters>/app/yarp_yolo_world.py</parameters>
    <node>yolo_node</node>
	</module>

  <module>
		<name>python</name>
		<parameters>/app/LLM4planning/code/chatGUI.py</parameters>
    <node>planner_node</node>
	</module>

  <module>
		<name>python</name>
		<parameters>/app/LLM4planning/code/FakeRobotNWS.py</parameters>
    <node>planner_node</node>
	</module>
  
  <module>
		<name>python</name>
		<parameters>/app/LLM4planning/code/planner_GUI.py --config /app/LLM4planning/code/configs/gpt_config_fc.json</parameters>
    <node>planner_node</node>
  </module>

  <module>
		<name>python</name>
		<parameters>/app/LLM4planning/code/observer.py --config /app/LLM4planning/code/configs/gpt_config_obs.json</parameters>
    <node>planner_node</node>
	</module>

  <module>
		<name>python</name>
		<parameters>/app/LLM4planning/code/internal_robot_state.py --config /app/LLM4planning/code/configs/gpt_config_intState.json</parameters>
    <node>planner_node</node>
	</module>

  

  <!-- recording audio from microphone -->
  <module>
    <name>yarprobotinterface</name>
    <parameters>--context speechPipeline --from micAudio.ini --mic_sound_on_stop 0 --mic_start 1 --mic_min_samples 4000 --mic_max_samples 4000</parameters>
    <node>r1-torso</node>
  </module>

  <module>
    <name>python3</name>
    <parameters>oww.py</parameters>
    <workdir>/usr/local/src/robot/tour-guide-robot/aux_modules/speechProcessing/openWakeWord</workdir>
    <node>console-llm</node>
  </module>

  <module>
    <name>sileroVAD</name>
    <parameters></parameters>
    <environment>YARP_LOG_PROCESS_LABEL=VAD</environment>
    <node>console-llm</node>
  </module>

  <module>
    <name>python3</name>
    <parameters>play_notification.py</parameters>
    <node>r1-face</node>
    <workdir>/usr/local/src/robot/tour-guide-robot/aux_modules/speechProcessing/wakeWordDetection</workdir>
  </module>

  <module>
    <name>yarprobotinterface </name>
    <parameters>--context headSynchronizer --from faceDisplay.ini</parameters>
    <node>r1-face</node>
  </module>

  <module>
    <name>yarprobotinterface</name>
    <parameters>--context vadModule --from audioPlayer.ini</parameters>
    <node>r1-face</node>
  </module>

  <module>
    <name>faceExpressionImage5GTour</name>
    <parameters></parameters>
    <node>console-llm</node>
  </module>




  <!-- speech synthesizer -->
  <module>
    <name>yarprobotinterface</name>
    <parameters>--context google --from googleSynthesizer.ini</parameters>
    <node>console-llm</node>
  </module>
    
  <!-- speech transcriber -->
  <module>
    <name>yarprobotinterface</name>
    <parameters>--context google --from googleTranscription.ini</parameters>
    <node>console-llm</node>
  </module>

  <!-- actions -->
  <module>
    <name>yarpActionsPlayer</name>
    <parameters>--filename yarpActionPlayer_config.ini --execute</parameters>
    <node>console</node>
    <workdir>/home/r1-user/yarpActionsPlayerFiles</workdir>
  </module>

    <!-- Modules connections -->

	<connection>
    <from>/cer/realsense_repeater/rgbImage:o</from>
    <to>/viewer</to>
  </connection>

  <connection>
    <from>/cer/realsense_repeater/rgbImage:o</from>
    <to>/yoloWDet/image:i</to>
  </connection>

  <connection>
    <from>/yoloWDet/image:o</from>
    <to>/viewer2</to>
  </connection>

	<connection>
    <from>/cer/realsense_repeater/rgbImage:o</from>
     <to>/observer/image:i</to>
  </connection>

  <connection>
		<from>/observer/text:o</from>
		<to>/observer/text:i</to>
	</connection>

  <connection>
      <from>/audioRecorder_nws/audio:o</from>
      <to>/wake/audio:i</to>
  </connection>

  <connection>
      <from>/wake/audio:o</from>
      <to>/vad/audio:i</to>
  </connection>

  <connection>
      <from>/vad/rpc:o</from>
      <to>/wake/rpc:i</to>
  </connection>

  <connection>
      <from>/audioPlayerWrapper/status:o</from>
      <to>/faceExpressionImage/mouthAudioData:i</to>
  </connection>

  <connection>
      <from>/audioRecorder_nws/status:o</from>
      <to>/faceExpressionImage/earsAudioData:i</to>
  </connection>

  <connection>
      <from>/faceExpressionImage/image:o</from>
      <to>/robot/faceDisplay/image:i</to>
  </connection>

  <connection>
      <from>/wake/notification:o</from>
      <to>/wake_notification:i</to>
  </connection>  

  <connection>
      <from>/wake/face:o</from>
      <to>/faceExpressionImage/rpc</to>
  </connection>  

  <connection>
      <from>/vad/audio:o</from>
      <to>/speechTranscription_nws/sound:i</to>
  </connection> 


  <!-- Connections -->
 
  <connection>
    <from>/audioRecorder_nws/audio:o</from>
    <to>/vad/audio:i</to>
  </connection>
 
  <connection>
    <from>/vad/audio:o</from>
    <to>/speechTranscription_nws/sound:i</to>
  </connection>
 
  <connection>  
    <from>/speechTranscription_nws/text:o</from>
    <to>/agent/text:i</to>
  </connection>
 
  <connection>
		<from>/agent/text:o</from>
		<to>/speechSynthesizer_nws/text:i</to>
		<protocol>fast_tcp</protocol>
	</connection>

  <connection>
    <from>/speechSynthesizer_nws/sound:o</from>
    <to>/audioPlayerWrapper/audio:i</to>
    <protocol>fast_tcp</protocol>
  </connection>

</application>



 

